    {
      "id": "1Efw3U65CDQhQT5tDwR08",
      "type": "text",
      "x": 7111.541955027388,
      "y": 2353.7628542906814,
      "width": 464.8955993652344,
      "height": 300,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 924977142,
      "version": 635,
      "versionNonce": 516138742,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786295537882,
      "link": null,
      "locked": false,
      "text": "Old fashioned way:\n- E.g. rotation = 'L339':\n    - Split L/R from rotation = ['L', '339']\n    - direction = rotation[0]\n    - turns = rotation[1]\n    - IFF direction == 'L', THEN:\n        for t < turns:\n            currPos = currPos - t\n            IFF currPos == -1, THEN:\n                currPos = MAX // -1 = 99 in wrapped numbers  \n    - IFF direction == 'R', THEN:\n        for t < turns:\n            currPos = currPos + t\n            IFF currPos == 100, THEN:\n                currPos. == MIN // Reset",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old fashioned way:\n- E.g. rotation = 'L339':\n    - Split L/R from rotation = ['L', '339']\n    - direction = rotation[0]\n    - turns = rotation[1]\n    - IFF direction == 'L', THEN:\n        for t < turns:\n            currPos = currPos - t\n            IFF currPos == -1, THEN:\n                currPos = MAX // -1 = 99 in wrapped numbers  \n    - IFF direction == 'R', THEN:\n        for t < turns:\n            currPos = currPos + t\n            IFF currPos == 100, THEN:\n                currPos. == MIN // Reset",
      "autoResize": true,
      "lineHeight": 1.25
    }
